GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# CORS: comma-separated, exact origins, no trailing slash
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: allow Vercel preview deployments of your project
# ALLOWED_ORIGIN_REGEX=https://ai-operations-command-center-.*\.vercel\.app

# Abuse protection for a public demo
RATE_LIMIT_PER_HOUR=5
DAILY_LIMIT=100
MAX_CONCURRENT=1
ANALYSIS_TIMEOUT_SECONDS=120